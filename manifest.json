{
  "manifest_version": 3,
  "name": "DevKit",
  "version": "1.0.0",
  "description": "A handy toolbox of everyday developer utilities: URL encoder, UUID generator, git branch names, JSON pretty print, diff, JSON/YAML, and password generator.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "DevKit",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["dev-tools/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
